  },
  "attributes": {
    "action": {
      "type": "string"
    },
    "collection": {
      "type": "string"
    },
    "recordId": {
      "type": "integer"
    },
    "changes": {
      "type": "json"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
